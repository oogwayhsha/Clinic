{
  // NUFV CARES: Realtime Database security rules
  // Paste into Firebase Console > Realtime Database > Rules, then Publish.
  //
  // "Clinic staff" below means:
  //   the main admin  (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2', same as shared/config.js)
  //   or an active account in admins/{uid} (added from the admin page)
  "rules": {

    "students": {
      ".read": "auth != null && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)"
      }
    },

    "employees": {
      ".read": "auth != null && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)"
      }
    },

    // Clinic staff accounts. Each person can read their own record (the
    // login page checks it); clinic staff manage the list.
    "admins": {
      ".read": "auth != null && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)",
      ".write": "auth != null && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "position": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "active": { ".validate": "newData.isBoolean()" }
      }
    },

    "appointments": {
      // Clinic staff read everything; a patient may only query their own
      ".read": "auth != null && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true || (query.orderByChild === 'uid' && query.equalTo === auth.uid))",
      ".indexOn": ["uid", "date"],

      "$id": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",

        // Clinic staff: anything.
        // Patient creating: their own, pending, and it must reserve its time slot in the same write.
        // Patient updating: can't move it or change whose it is; status may only become "cancelled".
        ".write": "auth != null && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending' && (root.child('students').child(auth.uid).exists() || root.child('employees').child(auth.uid).exists()) && newData.parent().parent().child('timeSlots').child(newData.child('date').val()).child(newData.child('time').val().replace(':', '')).val() === $id) || (data.exists() && data.child('uid').val() === auth.uid && newData.child('uid').val() === auth.uid && newData.child('date').val() === data.child('date').val() && newData.child('time').val() === data.child('time').val() && (newData.child('status').val() === data.child('status').val() || newData.child('status').val() === 'cancelled')))",

        "date": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "time": { ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)" },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(pending|approved|confirmed|declined|cancelled|completed|missed)$/)"
        },
        "attendance": {
          ".validate": "newData.isString() && newData.val().matches(/^(pending|confirmed)$/)"
        },
        "reason": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "instructions": { ".validate": "newData.isString() && newData.val().length <= 600" }
      }
    },

    // timeSlots/{date}/{HHMM} = appointmentId
    // One appointment per 30-minute slot: a taken slot can't be overwritten,
    // only freed by its own patient or clinic staff.
    "timeSlots": {
      ".read": "auth != null",
      "$date": {
        "$slot": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true || newData.parent().parent().parent().child('appointments').child(newData.val()).child('uid').val() === auth.uid)) || (data.exists() && !newData.exists() && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true || root.child('appointments').child(data.val()).child('uid').val() === auth.uid)))",
          ".validate": "newData.isString() && newData.parent().parent().parent().child('appointments').child(newData.val()).child('date').val() === $date && newData.parent().parent().parent().child('appointments').child(newData.val()).child('time').val().replace(':', '') === $slot"
        }
      }
    },

    // The reasons patients choose from (edited by clinic staff)
    "bookingReasons": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)",
      "$id": {
        ".validate": "newData.hasChildren(['name', 'active', 'order']) && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('active').isBoolean() && newData.child('order').isNumber()"
      }
    },

    // clinicClosures/{date} = "Holiday": no bookings that day
    "clinicClosures": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)",
      "$date": {
        ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isString() && newData.val().length <= 80"
      }
    },

    // In-app notifications.
    // notifications/clinic = the clinic's shared inbox (every clinic staff account sees it).
    // notifications/{uid}  = one person's own. Anyone signed in can send one
    // (signed as themselves); only the owner reads, marks read or deletes.
    "notifications": {
      "clinic": {
        ".read": "auth != null && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".indexOn": ["createdAt"],
        "$nid": {
          ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)",
          ".validate": "newData.hasChildren(['title', 'createdAt'])",
          "title": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "body": { ".validate": "newData.isString() && newData.val().length <= 500" }
        }
      },
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": ["createdAt"],
        "$nid": {
          ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || auth.uid === $uid)",
          ".validate": "newData.hasChildren(['title', 'createdAt'])",
          "title": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "body": { ".validate": "newData.isString() && newData.val().length <= 500" }
        }
      }
    },

    // Profile photos (small JPEGs): the person themselves and clinic staff
    "avatars": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".validate": "newData.hasChildren(['photo']) && newData.child('photo').isString() && newData.child('photo').val().beginsWith('data:image/jpeg;base64,') && newData.child('photo').val().length < 200000"
      }
    },

    // Card UID -> account (for card tap login). Readable one card at a time
    // before login, never as a list. Passwords may NOT be stored here.
    "rfid_lookup": {
      "$card": {
        ".read": true,
        ".write": "auth != null && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
        "authKey": { ".validate": false }
      }
    },

    // Phone scanner station broadcasts the last tapped card to the login page
    "rfid_tap": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren(['cardUid', 'timestamp']) && newData.child('cardUid').isString() && newData.child('cardUid').val().length <= 32"
    },

    "contactMessages": {
      ".read": "auth != null && (auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)",
      "$id": {
        ".write": "auth != null && (!data.exists() || auth.uid === 'dMcFELN1ildDnJL4AEwUxAq0SLE2' || root.child('admins').child(auth.uid).child('active').val() === true)"
      }
    }
  }
}
